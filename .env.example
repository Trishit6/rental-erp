# Frontend (Vite) — optional; the client uses relative /api via the dev proxy by default
# VITE_API_URL=http://localhost:3001/api

# MariaDB connection (development defaults)
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=reloop

# Optional single-URL override (takes precedence over DB_* vars)
# DATABASE_URL=mysql://root:password@localhost:3307/reloop

NODE_ENV=development
API_PORT=3001

# ---------------------------------------------------------------------------
# Seeded account credentials (`pnpm db:seed`).
#
# ADMIN_PASSWORD applies to the admin account; DEMO_PASSWORD applies to the seller
# and customer demo/volume accounts, which all share it. When neither is set the
# seeders generate a random password ONCE and write it to `.seed-credentials.local`
# (gitignored) — so no working credential is ever committed. Set these before
# seeding to choose your own. Never prefix them with VITE_ (a VITE_ value is public).
# ADMIN_EMAIL defaults to admin@revaro.local when unset.
# ---------------------------------------------------------------------------
# ADMIN_EMAIL=admin@revaro.local
# ADMIN_PASSWORD=
# DEMO_PASSWORD=

# JWT signing secrets — REQUIRED by the API (see server/lib/env.ts).
# Generate one for each, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# They sign/verify the HttpOnly auth cookies, so treat them like credentials:
# long, random, different from each other, and never committed to Git.
# Never prefix these with VITE_ — a VITE_-prefixed value is public.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# MFA encryption key — REQUIRED. 32 bytes as base64 or 64 hex characters. It
# encrypts each user's TOTP secret (AES-256-GCM) before it is stored, so a database
# dump is ciphertext. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never prefix with VITE_ — a VITE_-prefixed value is public.
MFA_ENCRYPTION_KEY=

# Development only. Comma-separated accounts that may use the staff area WITHOUT a
# second factor (OTP). Defaults to ADMIN_EMAIL. It is ignored entirely when
# NODE_ENV=production, so it can never weaken a real deployment.
# MFA_BYPASS_EMAILS=admin@revaro.local

# ---------------------------------------------------------------------------
# Optional auth tuning. The defaults are the documented behaviour:
#   AUTH_ACCESS_TTL_SECONDS=900          access JWT lifetime (15 minutes)
#   AUTH_REFRESH_TTL_SECONDS=604800      refresh cookie lifetime (7 days)
#   AUTH_REFRESH_REUSE_GRACE_SECONDS=60  two-tab refresh window
#   AUTH_MFA_TICKET_TTL_SECONDS=300      window to enter a TOTP code after a password
#   AUTH_PASSWORD_RESET_TTL_SECONDS=3600 how long a reset link stays valid
#   AUTH_LOGIN_WINDOW_SECONDS=900        failure look-back window
#   AUTH_LOGIN_LOCKOUT_SECONDS=900       how long a locked identifier stays locked
#   AUTH_LOGIN_MAX_FAILURES=5            failures in the window before lockout
#   AUTH_COOKIE_SECURE=true              force the Secure attribute on auth cookies
#                                        (production already sets it; use this when a
#                                        dev proxy terminates TLS and the app runs on http)
#   AUTH_ALLOWED_ORIGINS=                extra trusted browser origins, comma-separated,
#                                        when the client is served from another host
#                                        than the API. Same-origin deployments need none.
#
#   BCRYPT_ROUNDS=12                     bcrypt cost for the legacy upgrade path
#                                        (clamped to 10–15; scrypt is the primary hash)
#   RATE_LIMIT_STORE=                    production defaults to the MariaDB store;
#                                        set `memory` for a single-process deployment
# ---------------------------------------------------------------------------
# RATE_LIMIT_STORE=
# BCRYPT_ROUNDS=
# AUTH_COOKIE_SECURE=
# AUTH_ALLOWED_ORIGINS=
# AUTH_ACCESS_TTL_SECONDS=
# AUTH_REFRESH_TTL_SECONDS=
# AUTH_REFRESH_REUSE_GRACE_SECONDS=
# AUTH_MFA_TICKET_TTL_SECONDS=
# AUTH_PASSWORD_RESET_TTL_SECONDS=
# AUTH_LOGIN_WINDOW_SECONDS=
# AUTH_LOGIN_LOCKOUT_SECONDS=
# AUTH_LOGIN_MAX_FAILURES=

# Application and API origins. APP_URL is the canonical client origin.
# APP_BASE_URL is accepted as a deprecated fallback and logs a one-time warning.
APP_URL=http://localhost:5173
API_URL=http://localhost:3001

# Payment provider. Leave PAYMENT_PROVIDER empty (or "mock") for local
# development: that selects the development-only mock, which simulates payments
# and moves no money. It refuses to run when NODE_ENV=production, so a
# half-configured deployment fails loudly rather than taking fake payments.
# Set a real provider name once its adapter is implemented.
PAYMENT_PROVIDER=mock
# PAYMENT_KEY_ID=
# PAYMENT_KEY_SECRET=
# PAYMENT_WEBHOOK_SECRET=

# UPI collect details for the payment QR. Leave UPI_PAYEE_VPA empty to offer no QR.
# UPI_PAYEE_NAME is the display name shown to the payer. Never prefix with VITE_.
# UPI_PAYEE_VPA=
# UPI_PAYEE_NAME=Revaro Marketplace

# Server-side platform fees (never exposed to the browser)
PLATFORM_SALE_FEE_PERCENT=5
PLATFORM_RENTAL_FEE_PERCENT=10

# Product image storage. Leave STORAGE_PROVIDER empty (or "dev") for local
# development: uploads are written to server/uploads/ and served back by the API.
# That adapter refuses to run when NODE_ENV=production, so a deployment cannot
# silently store seller images on an ephemeral filesystem.
# Set STORAGE_PROVIDER=supabase plus the two secrets below for real storage.
# Never prefix SUPABASE_* with VITE_ — a VITE_-prefixed value is public.
STORAGE_PROVIDER=dev
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=product-images

# In-app assistant (Loop). Optional — without a key it answers from the built-in
# knowledge base. Any OpenAI-compatible endpoint works (Groq, OpenAI, OpenRouter...).
# Free Groq keys: https://console.groq.com/keys
# CHATBOT_API_KEY=
# CHATBOT_BASE_URL=https://api.groq.com/openai/v1
# CHATBOT_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Seed tuning (development only). All stages are deterministic and refuse to run
# when NODE_ENV=production.
#   SEED=                                PRNG seed for the demo stage
#   PRODUCT_COUNT=20000                  bulk products created by seed-products
#   CLEAR_PRODUCTS=1                     clear existing bulk products first
#   SEED_ADMIN=20261002                  PRNG seed for the admin stage
#   HISTORY_SCALE=1                      scale factor for the volume stage
#   HISTORY_SEED=20261002                PRNG seed for the volume stage
#   HISTORY_PASSWORD=                    password for volume accounts (defaults to
#                                        DEMO_PASSWORD / the generated credentials file)
# ---------------------------------------------------------------------------
# SEED=
# PRODUCT_COUNT=
# CLEAR_PRODUCTS=
# SEED_ADMIN=
# HISTORY_SCALE=
# HISTORY_SEED=
# HISTORY_PASSWORD=

# ---------------------------------------------------------------------------
# Production payments (Razorpay). Leave PAYMENT_PROVIDER as mock (default) for
# development; set azorpay to enable the real adapter and provide the keys.
# Secrets must never be prefixed with VITE_ and never reach the client:
# the server returns only RAZORPAY_KEY_ID (public) to the browser.
# ---------------------------------------------------------------------------
# PAYMENT_PROVIDER=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

